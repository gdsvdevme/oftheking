{
    "extends": "./tsconfig.json",
    "compilerOptions": {
      "noEmit": true,
      "skipLibCheck": true,
      "allowJs": true,
      "checkJs": false,
      "noImplicitAny": false,
      "strictNullChecks": false,
      "skipDefaultLibCheck": true
    },
    "include": ["server/**/*", "shared/**/*", "client/**/*"],
    "exclude": ["node_modules"]
  }